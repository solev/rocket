{
  "name": "rocket",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run env:check && bun run test && bun run test:integration && bun run db:drift && bun run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run --project unit --project dom",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project dom --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:drift": "bun run scripts/check-migration-drift.ts",
    "db:test:setup": "bun run scripts/setup-test-database.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U postgres -d rocket",
    "env:check": "bun run scripts/check-env-example.ts",
    "check:e2e": "bun run check && bun run test:e2e"
  },
