## Local development Postgres connection string
## Works with the Docker setup and a native PostgreSQL server using these credentials.
## See README "Local Postgres".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rocket

## Dedicated database for integration tests. Required by `bun run test:integration`,
## and so by `bun run check`, which runs it. The suite truncates and re-migrates
## whatever it connects to, so it must differ from DATABASE_URL and its name must
## contain "test" — the harness refuses otherwise. `bun run db:up` creates this one.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rocket_test

## Session signing. Both are REQUIRED in production and optional in development.
# BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# BETTER_AUTH_URL=https://example.com

## The single header your proxy sets to the real client IP, used to bucket auth
## rate limits per caller. Without it Better Auth cannot tell callers apart and
## puts everyone in one shared bucket per path, so a few failed sign-ins from
## any one person lock out every user.
##
## Pick a header your proxy ALWAYS overwrites; anything a client can forge
## defeats the limit. Common values: x-real-ip (nginx, Caddy, most proxies),
## cf-connecting-ip (Cloudflare), fly-client-ip (Fly.io), x-vercel-forwarded-for
## (Vercel).
# AUTH_IP_ADDRESS_HEADER=x-real-ip

## Set automatically by Vercel — leave unset elsewhere. Vercel Web Analytics
## only has somewhere to report to when Vercel is serving the app, so this
## decides whether its client script loads at all.
# VERCEL=1

## ---------------------------------------------------------------------------
## Optional capabilities
##
## Absent configuration is valid and means the capability is unavailable.
## PARTIAL configuration is a startup error, never a degraded state.
## ---------------------------------------------------------------------------

## Google sign-in — set BOTH or NEITHER.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

## Azure AI Chat (experimental) — set BOTH the resource name and the API key.
## See docs/capabilities/ai-chat.md
# AZURE_OPENAI_RESOURCE_NAME=your-resource-name
# AZURE_OPENAI_API_KEY=your-api-key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-chat

## Polar billing — see docs/capabilities/billing.md
## Billing becomes available as soon as POLAR_ACCESS_TOKEN is set.
# POLAR_ACCESS_TOKEN=...
# POLAR_SERVER=sandbox
# POLAR_PRODUCT_PRO_ID=...
## Requires POLAR_ACCESS_TOKEN; setting it alone is a startup error.
# POLAR_WEBHOOK_SECRET=...
## Operational kill switch for a fully configured integration.
# POLAR_ENABLED=false
