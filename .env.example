## Local development Postgres connection string
## Works with the Docker setup and a native PostgreSQL server using these credentials.
## See README "Local Postgres".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rr7_test

## For Google auth, also set (example placeholders):
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

## Azure OpenAI (required for /dashboard/ai)
# AZURE_OPENAI_RESOURCE_NAME=your-resource-name
# AZURE_OPENAI_API_KEY=your-api-key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-chat

## Polar payments (see https://www.better-auth.com/docs/plugins/polar)
## Billing is OFF unless POLAR_ACCESS_TOKEN is set. When off, the Polar plugin is
## not mounted at all: sign-up works normally and the billing page shows a notice.
## Set POLAR_ENABLED=false to force it off even when a token is present.
# POLAR_ENABLED=false
# POLAR_ACCESS_TOKEN=...
# POLAR_SERVER=sandbox # or production
# POLAR_WEBHOOK_SECRET=... # if using webhooks plugin
# Map your Polar product for the Pro plan (from Polar dashboard)
# POLAR_PRODUCT_PRO_ID=...
